# Cloudflare Pages — headers. Trang quản trị /admin/ không được lộ ra ngoài mọi công cụ tìm
# kiếm/preview — meta robots trong <head> đã có, thêm header X-Robots-Tag để chắc chắn ngay cả
# khi bot bỏ qua <meta>. TUYỆT ĐỐI KHÔNG khai Disallow cho đường dẫn này trong robots.txt —
# Disallow là 1 file public, khai vào đó vô tình công bố sự tồn tại của trang quản trị.
/admin/*
  X-Robots-Tag: noindex, nofollow, noarchive, nosnippet, noimageindex

# Cache tài nguyên tĩnh. Tên file ảnh/font không đổi khi cập nhật nội dung nên để 30 ngày;
# CSS/JS sửa thường xuyên (không có hash trong tên file) nên chỉ cache 1 ngày.
/images/*
  Cache-Control: public, max-age=2592000
/fonts/*
  Cache-Control: public, max-age=31536000, immutable
/css/*
  Cache-Control: public, max-age=86400
/js/*
  Cache-Control: public, max-age=86400
/data/*
  Cache-Control: public, max-age=86400
