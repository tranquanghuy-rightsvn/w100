            { "key": "text", "label": "Màu chữ", "type": "color", "default": "#0b0f14" },
            { "key": "opacity", "label": "Độ trong suốt nền", "type": "range", "min": 0, "max": 1, "step": 0.05, "default": 1 },
            { "key": "font", "label": "Font chữ", "type": "font", "default": "jakarta" },
            { "key": "navFontSize", "label": "Kích thước chữ menu", "type": "fontSize", "cssVar": "--blk-menu-nav-size", "min": 11, "max": 20, "step": 1, "default": 14 }, { "key": "shadow", "label": "Đổ bóng", "type": "shadow", "min": 0, "max": 30, "step": 1, "default": 0, "lockWhen": { "key": "opacity", "lt": 1 } }, { "key": "navHoverEffect", "label": "Hiệu ứng hover menu", "type": "navHover", "default": "none", "colorDefault": "#0bcb68" },
            { "key": "overlay", "label": "Nền trong suốt, đè lên khối dưới", "type": "toggle", "default": false, "hidden": true, "autoWhen": { "key": "opacity", "lt": 1 } }
          ]
        },
        {
          "id": "menu-split-center",
          "label": "Menu — logo giữa, nav 2 bên",
          "html": "<header class=\"blk blk-menu blk-menu--split-center\"><ul class=\"blk-menu__nav\" data-list-container=\"navItemsLeft\"></ul><img class=\"blk-menu__logo-img\" data-field=\"logo\" src=\"{{logo}}\" alt=\"Logo\"><ul class=\"blk-menu__nav\" data-list-container=\"navItemsRight\"></ul><template data-list-template=\"navItemsLeft\"><li><a data-item-field=\"label\">{{label}}</a></li></template><template data-list-template=\"navItemsRight\"><li><a data-item-field=\"label\">{{label}}</a></li></template></header>",
