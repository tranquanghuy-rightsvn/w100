          ]
        }
      ]
    },
    {
      "id": "hero",
      "label": "Hero Banner",
      "icon": "<svg viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"1.8\"><rect x=\"3\" y=\"4\" width=\"18\" height=\"14\" rx=\"2\"/><path d=\"M3 15l5-4 4 3 5-5 4 3\"/></svg>",
      "variants": [
        {
          "id": "hero-full-left",
          "label": "Hero — ảnh full màn hình, chữ trái",
          "html": "<section class=\"blk blk-hero blk-hero--full blk-hero--full-left\"><div class=\"blk-hero__bgwrap\"><img data-field=\"image\" src=\"{{image}}\" alt=\"\"></div><div class=\"blk-hero__content\"><span class=\"blk-badge\" data-field=\"badge\">{{badge}}</span><h1 class=\"blk-heading\" data-field=\"heading\">{{{heading}}}</h1><p class=\"blk-lead\" data-field=\"lead\">{{lead}}</p><div class=\"blk-hero__actions\"><a class=\"blk-btn blk-btn--primary\" data-field=\"ctaPrimary\" href=\"#\">{{ctaPrimary}}</a><a class=\"blk-btn blk-btn--outline\" data-field=\"ctaOutline\" href=\"#\">{{ctaOutline}}</a></div></div></section>",
          "fields": [
            { "key": "badge", "type": "text", "default": "Websites with a human touch" },
            { "key": "heading", "type": "richtext", "default": "Tiêu đề nổi bật<br>trên ảnh toàn màn hình" },
