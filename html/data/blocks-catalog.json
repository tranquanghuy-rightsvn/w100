{
  "fonts": [
    { "id": "jakarta", "label": "Plus Jakarta Sans", "google": "Plus+Jakarta+Sans:wght@400;500;600;700;800", "stack": "'Plus Jakarta Sans', system-ui, sans-serif" },
    { "id": "inter", "label": "Inter", "google": "Inter:wght@400;500;600;700;800", "stack": "'Inter', system-ui, sans-serif" }
  ],
  "types": [
    {
      "id": "menu",
