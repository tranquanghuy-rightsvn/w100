            { "key": "ctaOutline", "type": "text", "default": "Tìm hiểu thêm", "customStyle": "button", "buttonStyleDefault": { "bg": "#ffffff", "bgOpacity": 1, "text": "#0b0f14", "font": "", "fontSize": 14, "paddingX": 20, "paddingY": 13, "radius": 24, "borderWidth": 0, "borderColor": "#ffffff", "hoverEffect": "lift" } },
            { "key": "image", "type": "image", "default": "images/hero-full-1600x900.jpg" }
          ],
          "style": [
            { "key": "bg", "label": "Màu lớp phủ", "type": "color", "default": "#0b0f14" },
            { "key": "text", "label": "Màu chữ", "type": "color", "default": "#ffffff" },
            { "key": "opacity", "label": "Độ đậm lớp phủ ảnh", "type": "range", "min": 0.15, "max": 1, "step": 0.05, "default": 0.55 },
