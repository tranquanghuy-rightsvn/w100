      "variants": [
        {
          "id": "menu-basic",
          "label": "Menu — logo trái, nav phải",
          "html": "<header class=\"blk blk-menu blk-menu--basic\"><img class=\"blk-menu__logo-img\" data-field=\"logo\" src=\"{{logo}}\" alt=\"Logo\"><ul class=\"blk-menu__nav\" data-list-container=\"navItems\"></ul><a class=\"blk-btn blk-btn--primary blk-btn--sm\" data-field=\"cta\">{{cta}}</a><template data-list-template=\"navItems\"><li><a data-item-field=\"label\">{{label}}</a></li></template></header>",
          "fields": [
            { "key": "logo", "type": "image", "default": "images/logo.png", "allowOverlay": false, "ratio": { "default": "4:1", "presets": [
      { "id": "1:1", "label": "1:1" },
      { "id": "4:3", "label": "4:3" },
      { "id": "16:9", "label": "16:9" },
      { "id": "4:1", "label": "4:1" }
    ] } },
            { "key": "cta", "type": "text", "default": "Liên hệ", "customStyle": "button", "buttonStyleDefault": { "bg": "#0bcb68", "bgOpacity": 1, "text": "#ffffff", "font": "", "fontSize": 13, "paddingX": 16, "paddingY": 9, "radius": 24, "borderWidth": 0, "borderColor": "#0bcb68", "hoverEffect": "darken" } },
