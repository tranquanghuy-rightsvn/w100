            { "key": "font", "label": "Font chữ", "type": "font", "default": "jakarta" },
            { "key": "dotsStyle", "label": "Kiểu nốt chỉ mục", "type": "select", "cssClassPrefix": "blk-hero--dots-", "options": [ { "id": "circle", "label": "Hình tròn" }, { "id": "dash", "label": "Gạch ngang" }, { "id": "dash-circle", "label": "Tròn + gạch (đang chọn)" } ], "default": "circle" }
          ]
        },
