            { "key": "slides", "type": "list", "sidebarAdd": true, "slideshow": true, "itemLabel": "ảnh slide", "itemFields": [ { "key": "image", "type": "image", "default": "images/hero-banner.png" } ], "default": [ { "image": "images/hero-slide-2-1600x900.jpg" }, { "image": "images/hero-slide-3-1600x900.jpg" }, { "image": "images/hero-slide-1-1600x900.jpg" } ] }
