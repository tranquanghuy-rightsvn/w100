            { "key": "navItems", "type": "list", "sidebarAdd": true, "noReorder": true, "itemLabel": "mục menu", "itemFields": [{ "key": "label", "type": "text", "default": "Mục menu" }], "default": [{ "label": "Trang chủ" }, { "label": "Dịch vụ" }, { "label": "Giới thiệu" }, { "label": "Liên hệ" }] }
